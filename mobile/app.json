{
  "expo": {
    "name": "ENSINA A.I",
    "slug": "ensina-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.profarthur.ensinaai",
      "infoPlist": {
        "NSCameraUsageDescription": "O ENSINA A.I usa a câmera para fotografar exercícios e tirar dúvidas com o Tutor IA.",
        "NSPhotoLibraryUsageDescription": "O ENSINA A.I acessa suas fotos para você enviar exercícios ao Tutor IA."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4A0552",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.profarthur.ensinaai"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O ENSINA A.I usa a câmera para fotografar exercícios e tirar dúvidas com o Tutor IA.",
          "photosPermission": "O ENSINA A.I acessa suas fotos para você enviar exercícios ao Tutor IA."
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#4A0552"
        }
      ]
    ],
    "scheme": "ensinaai"
  }
}
