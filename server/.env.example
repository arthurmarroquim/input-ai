ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
PORT=3333
# Administrador criado na primeira vez que o servidor sobe.
# Sem ADMIN_PASSWORD, uma senha forte é gerada e mostrada uma vez no terminal.
ADMIN_EMAIL=admin@ensina.ai
ADMIN_PASSWORD=
# Perguntas ao Tutor IA por aluno por dia (0 = sem limite). Administradores não têm limite.
TUTOR_LIMITE_DIARIO=40
# Opcional: outro modelo do Claude para o Tutor
# TUTOR_MODEL=claude-opus-5-5
